# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta — NUNCA commitar, ignora RLS. Preencher só em .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# n8n — integrações (Fase 1: estrutura pronta, sem automação ativa)
N8N_WEBHOOK_SECRET=

# Google Docs — conta de serviço (Google Cloud Console → Credenciais)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Pasta do Drive compartilhada com a conta de servico (Editor)
GOOGLE_DRIVE_FOLDER_ID=
